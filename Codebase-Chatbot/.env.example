# Copy to .env beside docker-compose.yml and fill in your credentials.
# Comments must start with #, not //.
JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_DB_NAME=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace-with-your-database-password
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=
JINA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
RERANKER_HOST_PORT=8001
UPSTASH_HOST=your-redis-host.upstash.io
UPSTASH_PORT=6379
UPSTASH_PASSWORD=
